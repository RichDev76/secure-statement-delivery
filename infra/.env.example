# Keycloak Admin Credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32

# Keycloak Client Configuration
KEYCLOAK_ADMIN_CLIENT=statement-service-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
KEYCLOAK_CONSUMER_CLIENT=statement-service-consumer-client
KEYCLOAK_CONSUMER_CLIENT_SECRET= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32

KEYCLOAK_REDIRECT_URI=http://localhost:8081/*
KEYCLOAK_WEB_ORIGIN=http://localhost:8081
KEYCLOAK_SSL_REQUIRED=none
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=3600
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=4200
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=4200
KEYCLOAK_CLIENT_TOKEN_LIFESPAN=3600

# PostgreSQL Configuration
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32

# Application Database Configuration
APP_DB=statementdb
APP_DB_USER=statementuser
APP_DB_PASSWORD= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32

# Config Server basic auth (clients: statement-service; health endpoint stays open for probes)
CONFIG_SERVER_USER=config-user
CONFIG_SERVER_PASSWORD= # Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32

# Statement Service Configuration (S3-compatible storage via Floci - see ADR 0014)
S3_BUCKET=statements
AWS_S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test # Floci does not enforce auth locally; any value works. Use a least-privilege IAM role in real deployments.
AWS_SECRET_ACCESS_KEY=test # Floci does not enforce auth locally; any value works. Use a least-privilege IAM role in real deployments.
STATEMENT_MASTER_KEY=  # REQUIRED: openssl rand -base64 32
STATEMENT_SIGNATURE_SECRET=  # REQUIRED: openssl rand -base64 32
