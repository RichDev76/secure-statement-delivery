meta {
  name: Retrieve audit logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/audit/logs?accountNumber=123456789&startDate=2026-08-01&endDate=2026-08-30&page=0&size=50
  body: none
  auth: bearer
}

params:query {
  accountNumber: 123456789
  startDate: 2026-08-01
  endDate: 2026-08-30
  page: 0
  size: 50
}

headers {
  x-correlation-id: {{$guid}}
  Accept: application/json
}

auth:bearer {
  token: {{ADMIN_ACCESS_TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns a page of audit log entries", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property('content');
    expect(body.content).to.be.an('array');
  });
}

docs {
  Get audit logs for statement operations. Can be filtered by account number and date range. Requires
  authentication and the AuditLogsSearch role.
}
