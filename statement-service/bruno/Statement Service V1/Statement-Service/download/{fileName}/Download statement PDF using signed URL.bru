meta {
  name: Download statement PDF using signed URL
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/download/:fileName?expires={{lastExpires}}&linkId={{lastLinkId}}&signature={{lastSignature}}
  body: none
  auth: none
}

params:query {
  expires: {{lastExpires}}
  linkId: {{lastLinkId}}
  signature: {{lastSignature}}
}

params:path {
  fileName: {{lastFileName}}
}

headers {
  Accept: application/octet-stream
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("downloads the decrypted statement as a binary stream", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader('content-type')).to.include('application/octet-stream');
  });
}

docs {
  Download the encrypted statement PDF file using a filename-based signed URL. Requires `expires`, `linkId`, AND
  `signature` query params — all three are validated server-side (`SignedLinkService.validate` cross-checks
  `linkId` against the stored link even when the signature itself verifies).

  `auth: none` is intentional, not an oversight: `/download/**` is whitelisted in `SecurityConfig` — the signed
  URL (HMAC + expiry + bounded redemption count) is the sole authorization mechanism for this endpoint.

  Chains off `{{lastFileName}}`/`{{lastExpires}}`/`{{lastLinkId}}`/`{{lastSignature}}`, set by "Get signed
  download link by statement id" — run Upload -> Get signed download link -> Download in sequence (or run the
  whole collection as a folder) for these to be populated with a real, currently-valid link.
}
