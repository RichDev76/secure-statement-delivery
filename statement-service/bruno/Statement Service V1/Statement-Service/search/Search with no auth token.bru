meta {
  name: Search with no auth token
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/search?accountNumber=123456789&startDate=2025-11-07&endDate=2025-11-09&page=0&size=50
  body: none
  auth: none
}

params:query {
  accountNumber: 123456789
  startDate: 2025-11-07
  endDate: 2025-11-09
  page: 0
  size: 50
}

headers {
  x-correlation-id: {{$guid}}
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("rejects an unauthenticated search", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().errorCode).to.equal('UNAUTHENTICATED');
  });
}
