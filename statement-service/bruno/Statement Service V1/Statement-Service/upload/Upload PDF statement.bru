meta {
  name: Upload PDF statement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/upload
  body: multipartForm
  auth: bearer
}

headers {
  X-Message-Digest: 4a1f8c5071de06cc2542958aa773881595cf2785251863b77235cb819429bd14
  Content-Type: multipart/form-data
  Accept: application/json
  x-correlation-id: {{$guid}}
}

auth:bearer {
  token: {{ADMIN_ACCESS_TOKEN}}
}

body:multipart-form {
  file: @file(fixtures/statement1.pdf) @contentType(application/pdf)
  accountNumber: {{uploadAccountNumber}}
  date: 2025-11-07
}

settings {
  encodeUrl: true
  timeout: 0
}

script:pre-request {
  bru.setVar('uploadAccountNumber', String(Date.now()));
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar('lastStatementId', res.body.statementId);
    bru.setEnvVar('lastAccountNumber', bru.getVar('uploadAccountNumber'));
  }
}

tests {
  test("uploads successfully and returns statement metadata", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body).to.have.property('statementId');
    expect(body).to.have.property('fileName');
    expect(body).to.have.property('fileSize');
    expect(body).to.have.property('uploadedAt');
  });
}

docs {
  Upload a PDF file with metadata. The SHA-256 message digest must be supplied in the `X-Message-Digest` header.

  Uses the committed fixture at `bruno/Statement Service V1/fixtures/statement1.pdf` — the digest above is that
  file's real SHA-256 and must be recomputed (`shasum -a 256 statement1.pdf`) if the fixture ever changes.

  accountNumber is generated fresh each run (current epoch millis) rather than hardcoded: statements has a unique
  constraint on (accountNumber, date), verified against the running service - a fixed accountNumber + fixed date
  makes this request fail with 500 STATEMENT_UPLOAD_FAILED (duplicate key on idx_statements_account_date) on every
  run after the first. Keeping the date fixed and only the account number unique is sufficient to avoid the
  collision.

  On success, stores `statementId` as `lastStatementId` and the generated `accountNumber` as `lastAccountNumber`
  so "Get signed download link by statement id" can chain off both - the account number must match the one this
  statement was actually uploaded under, or the link endpoint treats the request as not found.
}
