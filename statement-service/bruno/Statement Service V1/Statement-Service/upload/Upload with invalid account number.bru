meta {
  name: Upload with invalid account number
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/upload
  body: multipartForm
  auth: bearer
}

headers {
  X-Message-Digest: 4a1f8c5071de06cc2542958aa773881595cf2785251863b77235cb819429bd14
  Content-Type: multipart/form-data
  Accept: application/json
  x-correlation-id: {{$guid}}
}

auth:bearer {
  token: {{ADMIN_ACCESS_TOKEN}}
}

body:multipart-form {
  file: @file(fixtures/statement1.pdf) @contentType(application/pdf)
  accountNumber: 123
  date: 2025-11-07
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("rejects an account number outside the 9-15 digit pattern", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include('application/problem+json');
    expect(res.getBody().errorCode).to.equal('INVALID_INPUT');
  });
}

docs {
  accountNumber must match ^[0-9]{9,15}$; "123" is too short. Uses the correct digest for fixtures/statement1.pdf
  so the digest check cannot mask this case.
  Verified against the running service: the generated controller's Bean Validation @Pattern rejects the value
  before service-level validation runs, so this returns errorCode INVALID_INPUT, not INVALID_ACCOUNT_NUMBER
  (same framework-first behaviour as the malformed digest header case).
}
